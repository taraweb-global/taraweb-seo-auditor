# TaraWeb SEO Auditor configuration example
# Copy to .env only if your process manager loads dotenv-style files.
# The application itself reads environment variables and never requires secrets.

TARAWEB_HOST=127.0.0.1
TARAWEB_PORT=5002
TARAWEB_MAX_REQUEST_BYTES=16777216
TARAWEB_MAX_FETCH_BYTES=10485760

# Security-sensitive overrides: leave disabled unless you understand the risk.
TARAWEB_ALLOW_PRIVATE_TARGETS=0
TARAWEB_ALLOW_INSECURE_TLS=0

# Optional local paths. Separate multiple directories with the platform path
# separator (semicolon on Windows, colon on macOS/Linux).
SITE_CRAWLER_EXTRA_CRAWL_DIRS=
SITE_CRAWLER_USER_MAP=

# Optional fixed anti-CSRF value for managed deployments. Do not commit a real
# value; when omitted, a strong random token is generated at startup.
TARAWEB_CSRF_TOKEN=
